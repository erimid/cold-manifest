{
  "note": "What the crew remember (S2.10, moved into content in S3.3; D-102, D-110). Each kind says how long it lasts in seconds, how it reads in the crew panel, and which bus events write it. See src/narrative/rules.js for the fields. F.6 (D-235) gave a kind weight: `captain` and `toward` move what they think of the captain and of the crewmate it is about. S4.3 adds decay and the rest.",
  "items": [
    {
      "id": "death",
      "seconds": 300,
      "text": "{who} dying in {room}",
      "bare": "{who} dying aboard their ship",
      "phrases": { "shadow": "{who} died in the dark" },
      "on": [{ "event": "crew.died", "to": "everyone", "names": true }]
    },
    {
      "id": "burn",
      "seconds": 240,
      "text": "burns in {room}",
      "bare": "burns",
      "phrases": { "shadow": "getting hurt in the dark in {room}" },
      "on": [{ "event": "crew.hurt", "to": "subject", "when": [{ "fact": "event", "field": "aboard", "eq": "player" }, { "fact": "event", "field": "cause", "eq": "fire" }] }]
    },
    {
      "id": "choke",
      "seconds": 240,
      "text": "no air in {room}",
      "bare": "no air",
      "phrases": { "shadow": "getting hurt in the dark in {room}" },
      "on": [{ "event": "crew.hurt", "to": "subject", "when": [{ "fact": "event", "field": "aboard", "eq": "player" }, { "fact": "event", "field": "cause", "eq": "suffocation" }] }]
    },
    {
      "id": "wound",
      "seconds": 240,
      "text": "a wound in {room}",
      "bare": "a wound",
      "phrases": { "shadow": "getting hurt in the dark in {room}" },
      "on": [{ "event": "crew.hurt", "to": "subject", "when": [{ "fact": "event", "field": "aboard", "eq": "player" }, { "not": { "fact": "event", "field": "cause", "in": ["fire", "suffocation"] } }] }]
    },
    {
      "id": "scare",
      "seconds": 300,
      "text": "the dark in {room}",
      "bare": "the dark",
      "phrases": { "shadow": "the dark in {room}" },
      "shadow": "always",
      "on": [{ "event": "crew.spooked", "to": "subject" }]
    },
    {
      "id": "override",
      "seconds": 420,
      "captain": -1,
      "text": "the captain overriding Margo in {room}",
      "bare": "the captain overriding Margo",
      "shadow": "never",
      "on": [
        { "event": "captain.overrode", "to": "everyone", "names": true, "when": { "fact": "event", "field": "grave", "eq": true } },
        { "event": "captain.overrode", "to": "named", "names": true, "when": { "fact": "event", "field": "grave", "eq": false } }
      ]
    },
    {
      "id": "kindness",
      "note": "F.6: written by a choice in a situation (the `remember` effect, usually with its own words). `captain` is how far it moves what they think of the captain.",
      "seconds": 1800,
      "captain": 2,
      "text": "a kindness from the captain",
      "shadow": "never"
    },
    {
      "id": "slight",
      "seconds": 1800,
      "captain": -2,
      "text": "a slight from the captain",
      "shadow": "never"
    },
    {
      "id": "wrong",
      "seconds": 2400,
      "captain": -4,
      "text": "a wrong the captain did",
      "shadow": "never"
    },
    {
      "id": "quarrel",
      "note": "F.6: `toward` is how far it moves what they think of the crewmate it is about.",
      "seconds": 1800,
      "toward": -4,
      "text": "the fight with {who}",
      "shadow": "never"
    },
    {
      "id": "spat",
      "seconds": 1200,
      "toward": -2,
      "text": "words with {who}",
      "shadow": "never"
    },
    {
      "id": "amends",
      "seconds": 1200,
      "toward": 3,
      "text": "making it up with {who}",
      "shadow": "never"
    },
    {
      "id": "help",
      "seconds": 1800,
      "toward": 2,
      "text": "{who} seeing them right",
      "shadow": "never"
    }
  ]
}
